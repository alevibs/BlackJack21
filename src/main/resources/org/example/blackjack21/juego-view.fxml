                  <HBox fx:id="hboxCartasComputador" alignment="CENTER" prefHeight="150.0" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #96a88c; -fx-background-radius: 30;" />
               </children>
            </VBox>
            <VBox fx:id="seccionMensajes" alignment="CENTER" layoutX="30.0" layoutY="30.0" prefWidth="100.0">
               <children>
                  <Label fx:id="lblMensaje" text="Ingresa tu apuesta para comenzar">
                     <font>
                        <Font name="System Bold Italic" size="18.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <VBox fx:id="seccionJugador" layoutX="30.0" layoutY="30.0" prefWidth="100.0">
