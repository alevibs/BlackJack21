                        </Label>
                        <Label fx:id="lblPuntajeComputador" layoutX="10.0" layoutY="10.0" text="PUNTAJE: 0 ">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                     </children>
