                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <HBox fx:id="hboxCartasJugador" alignment="CENTER" prefHeight="150.0" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #96a88c; -fx-background-radius: 30;" />
               </children>
            </VBox>
            <VBox fx:id="seccionControles" layoutX="30.0" layoutY="30.0" prefWidth="100.0" spacing="10.0">
               <children>
                  <HBox alignment="CENTER" prefWidth="200.0" spacing="20.0">
                     <children>
                        <Label fx:id="lblSaldo" text="SALDO: 1000">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblApuesta" layoutX="426.0" layoutY="52.0" text="APUESTA: 0">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtApuesta" promptText="Ingresa la apuesta Ej: 100" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefWidth="200.0" spacing="15.0">
                     <children>
                        <Button fx:id="btnIniciar" mnemonicParsing="false" onAction="#onIniciarRonda" text="Iniciar ronda" />
                        <Button fx:id="btnPedir" disable="true" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onPedirCarta" text="Pedir carta" />
                        <Button fx:id="btnPlantarse" disable="true" layoutX="92.0" layoutY="10.0" mnemonicParsing="false" onAction="#onPlantarse" text="Plantarse" />
                        <Button fx:id="btnReglas" layoutX="165.0" layoutY="10.0" mnemonicParsing="false" onAction="#onVerReglas" text="Ver reglas" />
                        <Button fx:id="btnCerrar" layoutX="230.0" layoutY="10.0" mnemonicParsing="false" onAction="#onCerrar" text="Cerrar juego" />
