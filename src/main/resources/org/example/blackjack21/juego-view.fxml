                  <Label text="BLACK JACK">
                     <font>
                        <Font name="System Bold" size="36.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <VBox fx:id="seccionComputador" prefWidth="100.0">
               <children>
                  <HBox prefWidth="200.0" spacing="20.0">
